<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven metadata artifact for uplus-mcp.

  This project does not compile Java code. It exists only to register the Python
  package in the GitHub Packages Apache Maven registry so the repository's
  Packages panel shows a published entry. The Maven coordinates are metadata
  only and cannot be consumed by pip: the installable distributions are the
  wheel and the sdist attached to the GitHub Release.

  Only the POM itself is published. The GitHub Packages Maven registry
  rejects artifacts whose extension it does not know, so attaching the
  wheel and the sdist to this POM made the whole deploy fail with 400 and
  left the Packages panel empty - the one thing this project exists for.

  Coordinates: com.github.jiangjunw15-web:uplus-mcp:0.8.0
  Keep <version> in sync with version in ../pyproject.toml at every release.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jiangjunw15-web</groupId>
  <artifactId>uplus-mcp</artifactId>
  <version>0.8.0</version>
  <packaging>pom</packaging>

  <name>uplus-mcp</name>
  <description>Python MCP server for the QingSoft U+ platform: course/homework/experiment patrol, objective-question answering, and an end-to-end experiment pipeline (materials search, report-template filling, inspection gate). This Maven entry is metadata only and registers the project in the GitHub Packages Maven registry; the installable wheel and sdist live in the GitHub Release.</description>
  <url>https://github.com/jiangjunw15-web/uplus-mcp</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/jiangjunw15-web/uplus-mcp/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>uplus-mcp-contributors</id>
      <name>uplus-mcp contributors</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/jiangjunw15-web/uplus-mcp.git</connection>
    <developerConnection>scm:git:https://github.com/jiangjunw15-web/uplus-mcp.git</developerConnection>
    <url>https://github.com/jiangjunw15-web/uplus-mcp</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/jiangjunw15-web/uplus-mcp</url>
    </repository>
  </distributionManagement>
</project>
